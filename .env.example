# ─────────────────────────────────────────────────────────────
# Honey Bee environment variables
# Copy to `.env` for local development. In production, set these in your host's panel.
# Lines marked (required) must be set; everything else is optional and the
# matching feature switches itself off when left empty.
# ─────────────────────────────────────────────────────────────

# ── App ──
# Public URL of the site, no trailing slash (required)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (required) ──
# Local dev: postgresql://USER:PASSWORD@localhost:5432/honeybee
# Hosted (Neon/Supabase): use the *pooled* connection string here, with sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/honeybee"
# Hosted only: the direct (non-pooled) connection string, used for migrations. Leave empty locally.
DIRECT_URL=""

# ── Authentication (required) ──
# Long random string; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Optional "Continue with Google" button
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── First admin account (used by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@honeybee.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ── Email (Resend: https://resend.com) ──
# Without a key, emails are printed to the console and saved to .emails/ (development only).
RESEND_API_KEY=""
EMAIL_FROM="Abdul Sami Enterprises <orders@honeybee.pk>"
# Where new-order alerts for the shop owner are sent
ADMIN_NOTIFY_EMAIL=""

# ── WhatsApp new-order alerts for the shop owner ──
# The number and on/off switch are in Admin → Settings → WhatsApp order alerts.
# Without keys, alerts are printed to the server console (development only).
# Option A, official: Meta WhatsApp Cloud API (business.facebook.com → WhatsApp → API setup).
# Alerts the shop starts must use an approved "Utility" template whose body has 3 placeholders:
#   {{1}} customer name, {{2}} order number, {{3}} order total
#   e.g. "New order {{2}} placed by {{1}} ({{3}}). Please review it in the admin."
# Without WHATSAPP_TEMPLATE, plain text is only delivered within 24h of you messaging the business number.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
# Option B, free and quick: CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/).
# From the admin's phone, send "I allow callmebot to send me messages" to the number on that page;
# it replies with your API key. Only sends to that one phone. Used when Option A isn't set.
CALLMEBOT_API_KEY=""

# ── Image storage (Cloudinary: https://cloudinary.com) ──
# Without these, uploads are saved to public/uploads/ (development only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Payments ──
# Cash on Delivery and Bank Transfer need no keys (configure them in Admin → Settings).
# Each online gateway turns on only when all its keys are present.

# Safepay (cards) — https://getsafepay.com
SAFEPAY_ENV="sandbox"            # sandbox | production
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""

# JazzCash — merchant portal: https://sandbox.jazzcash.com.pk
JAZZCASH_ENV="sandbox"           # sandbox | production
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Easypaisa — merchant portal: https://easypay.easypaisa.com.pk
EASYPAISA_ENV="sandbox"          # sandbox | production
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# Stripe — only for an eligible non-Pakistani business entity
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Rate limiting (optional, recommended for multi-server hosting) ──
# Without these, an in-memory limiter is used (fine for a single server).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Scheduled jobs ──
# Secret for the cron endpoint that cancels expired unpaid orders (/api/cron/expire-orders)
CRON_SECRET="change-me-too"
